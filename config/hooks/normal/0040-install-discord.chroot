#!/bin/sh
set -e

# This hook will install Discord, the social app to the system. Hook will use the discord .deb for easy installation.

# Download latest Discord .deb
wget -O /tmp/discord.deb "https://discord.com/api/download?platform=linux&format=deb"

# Install it
apt-get update
apt-get install -y /tmp/discord.deb

# Clean up
rm /tmp/discord.deb
