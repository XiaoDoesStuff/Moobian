#!/bin/sh
set -e

echo "[Moobian] Removing Gnome and Debian bloat..."

apt update

apt purge -y \
  libreoffice* \
  gnome-maps \
  gnome-weather \
  gnome-music
  eog \
  shotwell \
  totem \
  gnome-sound-recorder \
  || true

apt autoremove -y --purge || true
apt clean

gnome-extensions enable ubuntu-appindicators@ubuntu
gnome-extensions enable ding@rastersoft.com
gnome-extensions enable dash-to-panel@jderose9.github.com

echo "[Moobian] Bloat removal complete."

