#!/bin/bash
set -e

# This hook will remove Debian logos and branding from the system.

echo "Removing system default avatars..."

# System-wide default faces
rm -rf /usr/share/icons/desktop-base/*/emblems/*
rm -rf /usr/share/icons/hicolor/*/emblems/*
rm -rf /usr/share/icons/desktop-base/debian-logos/*
rm -rf /usr/share/pixamps/debian-logo.png
rm -rf /usr/share/desktop-base/debian-logos/*

