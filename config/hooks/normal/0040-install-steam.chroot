#!/bin/sh
set -e

# This hook will install Steam via Flatpak, the game vendor app, to the system. The hook will add Flathub as a remote for FLatpak.

echo "Installing Steam via Flatpak..."

# Add Flathub remote
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

# Install Steam
flatpak install -y flathub com.valvesoftware.Steam

echo "Steam Flatpak installation complete."
