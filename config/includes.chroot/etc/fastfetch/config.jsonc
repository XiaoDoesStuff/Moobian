{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "none",
    "padding": {
      "top": 1,
      "right": 4
    }
  },

  "display": {
    "separator": " : "
  },

  "modules": [
    {
      "type": "custom",
      "format": "           \\ | /\n         --- ☼ ---\n           / | \\\n            ______________________\n           <      MOOOOOOO!       >\n            ----------------------\n                   \\\\   ^__^\n                    \\\\  (oo)\\\\_______\n                       (__)\\\\       )\\\\\n                           ||----w |  \\\\\n                           ||     ||\n       . . . . . . . . . . . . . . . . . . . .\n        .   v   v   v   v   v   v   v   v   v   .\n        . . . . . . . . . . . . . . . . . . . ."
    },


    {
      "type": "os",
      "key": "OS"
    },

    {
      "type": "kernel",
      "key": "Kernel"
    },

    {
      "type": "uptime",
      "key": "Uptime"
    },

    {
      "type": "packages",
      "key": "Packages"
    },

    {
      "type": "shell",
      "key": "Shell"
    },

    {
      "type": "cpu",
      "key": "CPU"
    },

    {
      "type": "gpu",
      "key": "GPU"
    },

    {
      "type": "memory",
      "key": "Memory"
    },

    "break",
  ]
}
