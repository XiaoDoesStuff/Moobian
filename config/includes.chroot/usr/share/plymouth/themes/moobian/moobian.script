# Load images
background = Image("background.png");
logo_image = Image("logo.png");
spinner_image = Image("spinner.png");

# Screen geometry
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Draw background full-screen
fun draw_background() {
    bg_w = background.GetWidth();
    bg_h = background.GetHeight();

    scale_x = screen_width / bg_w;
    scale_y = screen_height / bg_h;

    scale = (scale_x > scale_y) ? scale_x : scale_y;

    background.Draw(0, 0, scale, 1.0);
}

# Logo placement
logo_scale = 0.35;
logo_width = logo_image.GetWidth() * logo_scale;
logo_height = logo_image.GetHeight() * logo_scale;

logo_x = (screen_width - logo_width) / 2;
logo_y = (screen_height - logo_height) / 2 - (screen_height * 0.10);

# Spinner placement
spinner_scale = 0.20;
spinner_width = spinner_image.GetWidth() * spinner_scale;
spinner_height = spinner_image.GetHeight() * spinner_scale;

spinner_x = (screen_width - spinner_width) / 2;
spinner_y = logo_y + logo_height + (screen_height * 0.05);

# Fade-in animation
opacity = 0.0;

fun draw() {
    # Draw background first
    draw_background();

    # Fade-in effect
    if (opacity < 1.0) {
        opacity += 0.02;
    }

    # Draw logo
    logo_image.Draw(logo_x, logo_y, logo_scale, opacity);

    # Spinner rotation
    t = Time.Get();
    angle = (t * 180) % 360;

    spinner_image.Rotate(angle);
    spinner_image.Draw(spinner_x, spinner_y, spinner_scale, opacity);
}

Plymouth.SetUpdateFunction(draw);

